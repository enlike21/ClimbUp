{% extends 'base.html.twig' %}

{% block title %}Mis Rutas Guardadas - ClimbUp{% endblock %}

{% block meta_description %}Gestiona tus rutas de escalada guardadas y completadas. Lleva un registro de tus ascensos y planifica tus próximas salidas.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/saved_routes/saved_routes.css?v=2.1') }}">
{% endblock %}

{% block body %}
    <div class="saved-routes-wrapper">
        <div class="saved-routes-hero">
            <div class="container">
                <h1 class="saved-routes-hero-title">
                    Mis <span class="text-gradient">Rutas</span>
                </h1>
                <p class="saved-routes-hero-subtitle">
                    Gestiona tus rutas guardadas y celebra tus logros
                </p>
            </div>
        </div>

        <div class="container saved-routes-container">
            <div class="stats-overview">
                <div class="stat-card glass-card">
                    <div class="stat-icon">
                        <i class="fas fa-bookmark"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-number" id="todoCount">{{ savedRoutes|length }}</div>
                        <div class="stat-label">Por Hacer</div>
                    </div>
                </div>

                <div class="stat-card glass-card">
                    <div class="stat-icon stat-icon-success">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-number" id="completedCount">{{ completedRoutes|length }}</div>
                        <div class="stat-label">Completadas</div>
                    </div>
                </div>

                <div class="stat-card stat-card-progress glass-card">
                    {% set totalRoutes = savedRoutes|length + completedRoutes|length %}
                    {% set progressPercent = totalRoutes > 0 ? ((completedRoutes|length / totalRoutes) * 100)|round : 0 %}
                    <div class="progress-ring-container" data-progress="{{ progressPercent }}">
                        <svg class="progress-ring" width="100" height="100" viewBox="0 0 100 100">
                            <defs>
                                <linearGradient id="progressGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#6366F1" />
                                    <stop offset="50%" stop-color="#8B5CF6" />
                                    <stop offset="100%" stop-color="#EC4899" />
                                </linearGradient>
                            </defs>
                            <circle class="progress-ring-bg" cx="50" cy="50" r="42" />
                            <circle class="progress-ring-fill" cx="50" cy="50" r="42"
                                    stroke="url(#progressGradient)"
                                    stroke-dasharray="263.89"
                                    stroke-dashoffset="263.89" />
                        </svg>
                        <div class="progress-ring-text">
                            <span class="progress-ring-value" id="progressValue">0</span>
                            <span class="progress-ring-symbol">%</span>
                        </div>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Progreso</div>
                        <div class="progress-detail">{{ completedRoutes|length }} de {{ totalRoutes }} rutas</div>
                    </div>
                </div>
            </div>

            {% if userStats is not empty %}
            <section class="user-stats-section glass-card">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <i class="fas fa-chart-bar section-icon"></i>
                        <h2 class="section-title">Mis Estadísticas</h2>
                    </div>
                </div>

                <div class="stats-grid">
                    <div class="stats-highlight">
                        <div class="max-grade-card">
                            <span class="max-grade-label">Grado máximo</span>
                            <span class="max-grade-value">{{ userStats.maxGrade ?? '—' }}</span>
                            <span class="max-grade-sub">{{ userStats.totalCompleted }} rutas completadas</span>
                        </div>
                    </div>

                    <div class="stats-chart-card">
                        <h4 class="stats-chart-title"><i class="fas fa-map-marked-alt"></i> Por Región</h4>
                        <div class="stats-bars" id="regionBars">
                            {% set maxRegionCount = userStats.byRegion|first %}
                            {% for region, count in userStats.byRegion|slice(0, 8) %}
                                <div class="stat-bar-row">
                                    <span class="stat-bar-label">{{ region }}</span>
                                    <div class="stat-bar-track">
                                        <div class="stat-bar-fill stat-bar-region" data-width="{{ maxRegionCount > 0 ? (count / maxRegionCount * 100)|round : 0 }}"></div>
                                    </div>
                                    <span class="stat-bar-value">{{ count }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="stats-chart-card">
                        <h4 class="stats-chart-title"><i class="fas fa-signal"></i> Por Grado</h4>
                        <div class="stats-bars" id="gradeBars">
                            {% set maxGradeCount = max(userStats.byGrade) %}
                            {% for grade, count in userStats.byGrade %}
                                <div class="stat-bar-row">
                                    <span class="stat-bar-label">{{ grade }}</span>
                                    <div class="stat-bar-track">
                                        <div class="stat-bar-fill stat-bar-grade" data-width="{{ maxGradeCount > 0 ? (count / maxGradeCount * 100)|round : 0 }}"></div>
                                    </div>
                                    <span class="stat-bar-value">{{ count }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {% if userStats.recent|length > 0 %}
                <div class="recent-timeline">
                    <h4 class="stats-chart-title"><i class="fas fa-history"></i> Últimas Completadas</h4>
                    <div class="timeline-list">
                        {% for item in userStats.recent %}
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <span class="timeline-name">{{ item.name }}</span>
                                    <span class="timeline-meta">
                                        <span class="timeline-badge">{{ item.difficulty }}</span>
                                        {{ item.location }} · {{ item.date }}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </section>
            {% endif %}

            <section class="routes-section">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <i class="fas fa-bookmark section-icon"></i>
                        <h2 class="section-title">Por Hacer</h2>
                        <span class="section-badge">{{ savedRoutes|length }}</span>
                    </div>
                </div>

                <div class="routes-grid" id="todo-routes">
                    {% if savedRoutes|length > 0 %}
                        {% for savedRoute in savedRoutes %}
                            <div class="route-card glass-card" id="route-{{ savedRoute.route.id }}" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 50 }}">
                                <div class="route-card-header">
                                    <h3 class="route-name">
                                        <a href="{{ path('app_route_show', {'id': savedRoute.route.id}) }}">{{ savedRoute.route.name }}</a>
                                    </h3>
                                    <span class="route-type-badge route-type-{{ savedRoute.route.routeType.value|lower }}">
                                        {{ savedRoute.route.routeType.value }}
                                    </span>
                                </div>

                                <div class="route-card-body">
                                    <div class="route-info-item">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>{{ savedRoute.route.location.name }}</span>
                                    </div>

                                    <div class="route-info-item">
                                        <i class="fas fa-signal"></i>
                                        <span>{{ savedRoute.route.difficulty }}</span>
                                    </div>

                                    <div class="route-info-item">
                                        <i class="fas fa-ruler-vertical"></i>
                                        <span>{{ savedRoute.route.length }}m</span>
                                    </div>

                                    <div class="route-info-item">
                                        <i class="fas fa-layer-group"></i>
                                        <span>{{ savedRoute.route.pitches }} largos</span>
                                    </div>
                                </div>

                                <div class="route-card-actions">
                                    <a href="{{ path('app_route_show', {'id': savedRoute.route.id}) }}" class="btn btn-route-detail">
                                        <i class="fas fa-eye"></i>
                                        <span>Ver</span>
                                    </a>
                                    <button class="btn btn-complete complete-btn" data-route-id="{{ savedRoute.route.id }}" data-route-name="{{ savedRoute.route.name }}" data-route-location="{{ savedRoute.route.location.name }}" data-route-type="{{ savedRoute.route.routeType.value }}">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Completar</span>
                                    </button>

                                    <button class="btn btn-delete delete-btn" data-route-id="{{ savedRoute.route.id }}">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="empty-state glass-card">
                            <div class="empty-state-icon">
                                <i class="fas fa-bookmark"></i>
                            </div>
                            <h3 class="empty-state-title">No tienes rutas guardadas</h3>
                            <p class="empty-state-text">
                                Explora rutas y guarda las que quieras hacer
                            </p>
                            <a href="{{ path('app_route_user_view') }}" class="btn btn-primary">
                                <i class="fas fa-search"></i>
                                <span>Explorar Rutas</span>
                            </a>
                        </div>
                    {% endif %}
                </div>
            </section>

            <section class="routes-section">
                <div class="section-header">
                    <div class="section-title-wrapper">
                        <i class="fas fa-trophy section-icon section-icon-success"></i>
                        <h2 class="section-title">Completadas</h2>
                        <span class="section-badge section-badge-success">{{ completedRoutes|length }}</span>
                    </div>
                </div>

                <div class="routes-grid" id="completed-routes">
                    {% if completedRoutes|length > 0 %}
                        {% for completedRoute in completedRoutes %}
                            <div class="route-card route-card-completed glass-card" id="completed-{{ completedRoute.route.id }}" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 50 }}">
                                <div class="completed-badge">
                                    <i class="fas fa-check-circle"></i>
                                </div>

                                <div class="route-card-header">
                                    <h3 class="route-name">
                                        <a href="{{ path('app_route_show', {'id': completedRoute.route.id}) }}">{{ completedRoute.route.name }}</a>
                                    </h3>
                                    <span class="route-type-badge route-type-{{ completedRoute.route.routeType.value|lower }}">
                                        {{ completedRoute.route.routeType.value }}
                                    </span>
                                </div>

                                <div class="route-card-body">
                                    <div class="route-info-item">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>{{ completedRoute.route.location.name }}</span>
                                    </div>

                                    <div class="route-info-item">
                                        <i class="fas fa-signal"></i>
                                        <span>{{ completedRoute.route.difficulty }}</span>
                                    </div>

                                    <div class="route-info-item">
                                        <i class="fas fa-calendar-check"></i>
                                        <span>{{ completedRoute.completedAt|date("d/m/Y") }}</span>
                                    </div>
                                </div>

                                {% if completedRoute.attemptType or completedRoute.personalRating or completedRoute.notes %}
                                    <div class="completed-meta">
                                        {% if completedRoute.attemptType %}
                                            <span class="attempt-type-badge">
                                                <i class="fas {{ completedRoute.attemptType.icon }}"></i>
                                                {{ completedRoute.attemptType.label }}
                                            </span>
                                        {% endif %}
                                        {% if completedRoute.personalRating %}
                                            <span class="rating-stars">
                                                {% for i in 1..5 %}<i class="fa{{ i <= completedRoute.personalRating ? 's' : 'r' }} fa-star"></i>{% endfor %}
                                            </span>
                                        {% endif %}
                                    </div>
                                    {% if completedRoute.notes %}
                                        <p class="completed-notes">"{{ completedRoute.notes }}"</p>
                                    {% endif %}
                                {% endif %}

                                <div class="route-card-actions">
                                    <a href="{{ path('app_route_show', {'id': completedRoute.route.id}) }}" class="btn btn-route-detail" style="flex: 1;">
                                        <i class="fas fa-eye"></i>
                                        <span>Ver Detalle</span>
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="empty-state glass-card">
                            <div class="empty-state-icon">
                                <i class="fas fa-trophy"></i>
                            </div>
                            <h3 class="empty-state-title">Aún no has completado rutas</h3>
                            <p class="empty-state-text">
                                ¡Marca tus primeras rutas como completadas!
                            </p>
                        </div>
                    {% endif %}
                </div>
            </section>
        </div>
    </div>

    <div class="modal-overlay" id="completeAscentModal">
        <div class="modal-content glass-card">
            <div class="modal-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h3 class="modal-title">¿Cómo la completaste?</h3>
            <p class="modal-text">Registra el estilo de tu ascenso (opcional)</p>

            <form id="completeAscentForm">
                <div class="attempt-type-group" id="attemptTypeGroup">
                    <button type="button" class="attempt-type-btn" data-value="onsight">
                        <i class="fas fa-eye"></i>
                        <span>A vista</span>
                    </button>
                    <button type="button" class="attempt-type-btn" data-value="flash">
                        <i class="fas fa-bolt"></i>
                        <span>Flash</span>
                    </button>
                    <button type="button" class="attempt-type-btn" data-value="redpoint">
                        <i class="fas fa-check-double"></i>
                        <span>Encadenado</span>
                    </button>
                    <button type="button" class="attempt-type-btn" data-value="toprope">
                        <i class="fas fa-arrow-up"></i>
                        <span>Top-rope</span>
                    </button>
                </div>

                <div class="star-rating" id="starRating">
                    {% for i in 1..5 %}
                        <i class="far fa-star star" data-value="{{ i }}" role="button" tabindex="0" aria-label="{{ i }} estrellas"></i>
                    {% endfor %}
                </div>

                <textarea class="ascent-notes" id="ascentNotes" maxlength="500" placeholder="Notas sobre la ruta, condiciones, beta... (opcional)"></textarea>

                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" id="cancelCompleteBtn">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <span>Marcar como completada</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="successModal">
        <div class="modal-content glass-card">
            <div class="modal-icon">
                <i class="fas fa-trophy"></i>
            </div>
            <h3 class="modal-title">¡Felicitaciones!</h3>
            <p class="modal-text">Has completado una ruta más</p>
            <div class="modal-route-info" id="modalRouteInfo"></div>
            <button class="btn btn-primary" onclick="closeSuccessModal()">
                <span>¡Genial!</span>
            </button>
        </div>
    </div>

    <div class="toast-container">
        <div class="toast toast-success" id="successToast">
            <div class="toast-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="toast-content">
                <div class="toast-title">¡Éxito!</div>
                <div class="toast-message" id="toastMessage"></div>
            </div>
            <button class="toast-close" onclick="closeToast()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/routes/saved_routes.js?v=1.3') }}"></script>
{% endblock %}