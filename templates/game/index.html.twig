            <svg class="game-hero-sky" viewBox="0 0 320 64" preserveAspectRatio="xMidYMin slice" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
                <g class="game-hero-stars">
                    <rect x="22" y="8" width="1" height="1"/><rect x="61" y="17" width="1" height="1"/><rect x="97" y="5" width="1" height="1"/>
                    <rect x="140" y="12" width="1" height="1"/><rect x="188" y="4" width="1" height="1"/><rect x="229" y="15" width="1" height="1"/>
                    <rect x="266" y="7" width="1" height="1"/><rect x="301" y="19" width="1" height="1"/><rect x="45" y="27" width="1" height="1"/>
                    <rect x="207" y="25" width="1" height="1"/>
                </g>
                <g class="game-hero-moon">
                    <rect x="258" y="9" width="6" height="8"/><rect x="257" y="10" width="8" height="6"/>
                </g>
            </svg>
            <svg class="game-hero-ridges" viewBox="0 0 320 64" preserveAspectRatio="xMidYMax slice" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
