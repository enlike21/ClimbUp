{% extends 'base.html.twig' %}

{% block title %}Página no encontrada - ClimbUp{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="error-page">
        <div class="container">
            <div class="error-content">
                <div class="error-code">404</div>
                <h1 class="error-title">Ruta no encontrada</h1>
                <p class="error-message">Parece que esta ruta no existe o ha sido eliminada. Puede que te hayas desviado del camino.</p>
                <div class="error-actions">
                    <a href="{{ path('homepage') }}" class="btn btn-primary btn-lg">
                        <i class="fas fa-home"></i>
                        <span>Volver al inicio</span>
                    </a>
                    <a href="{{ path('app_route_user_view') }}" class="btn btn-secondary btn-lg">
                        <i class="fas fa-route"></i>
                        <span>Explorar rutas</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
