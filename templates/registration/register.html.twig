{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Crear Cuenta - Registro en ClimbUp{% endblock %}

{% block meta_description %}Crea tu cuenta en ClimbUp gratis. Descubre rutas de escalada, guarda tus favoritas, registra tus logros y únete a la comunidad de escaladores.{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/security/login_register_form.css?v=1.1') }}">
{% endblock %}

{% block body %}
    <div class="auth-container">
        {# Header section #}
        <div class="auth-header">
            <h1 class="auth-title">Únete a ClimbUp</h1>
            <p class="auth-subtitle">Comienza tu aventura de escalada</p>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" role="alert">
                    <div class="alert-content">
                        <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'error' ? 'exclamation-circle' : 'info-circle') }}"></i>
                        <span>{{ message }}</span>
                    </div>
                    <button type="button"
                            class="btn-close"
                            onclick="closeAlert(this)"
                            aria-label="Cerrar alerta">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Registration card #}
        <div class="auth-card">
            {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'class': 'auth-form'}}) }}

            {# Email field #}
            <div class="form-group {{ registrationForm.email.vars.errors|length > 0 ? 'has-error' : '' }}">
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-wrapper">
                    <i class="fas fa-envelope input-icon" aria-hidden="true"></i>
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'tu@email.com',
                            'autocomplete': 'email'
                        }
                    }) }}
                </div>
                {{ form_errors(registrationForm.email) }}
            </div>

            {# Name field #}
            <div class="form-group {{ registrationForm.name.vars.errors|length > 0 ? 'has-error' : '' }}">
                {{ form_label(registrationForm.name, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-wrapper">
                    <i class="fas fa-user input-icon" aria-hidden="true"></i>
                    {{ form_widget(registrationForm.name, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Tu nombre completo',
                            'autocomplete': 'name'
                        }
                    }) }}
                </div>
                {{ form_errors(registrationForm.name) }}
            </div>

            {# Password field #}
            <div class="form-group {{ registrationForm.plainPassword.first.vars.errors|length > 0 ? 'has-error' : '' }}">
                {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon" aria-hidden="true"></i>
                    {{ form_widget(registrationForm.plainPassword.first, {
                        'attr': {
                            'class': 'form-control password-field',
                            'placeholder': '••••••••',
                            'id': 'registration_form_plainPassword_first',
                            'autocomplete': 'new-password'
                        }
                    }) }}
                    <button type="button"
                            class="toggle-password"
                            onclick="togglePasswordVisibility('registration_form_plainPassword_first', this)"
                            aria-label="Mostrar contraseña">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <div class="password-strength" id="passwordStrength">
                    <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                    <span class="strength-text" id="strengthText"></span>
                </div>
                <small class="form-hint">
                    <i class="fas fa-shield-alt"></i>
                    Mínimo 8 caracteres con mayúscula, minúscula y número
                </small>
                {{ form_errors(registrationForm.plainPassword.first) }}
            </div>

            {# Confirm password field #}
            <div class="form-group {{ registrationForm.plainPassword.second.vars.errors|length > 0 ? 'has-error' : '' }}">
                {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-wrapper">
                    <i class="fas fa-lock input-icon" aria-hidden="true"></i>
                    {{ form_widget(registrationForm.plainPassword.second, {
                        'attr': {
                            'class': 'form-control password-field',
                            'placeholder': '••••••••',
                            'id': 'registration_form_plainPassword_second',
                            'autocomplete': 'new-password'
                        }
                    }) }}
                    <button type="button"
                            class="toggle-password"
                            onclick="togglePasswordVisibility('registration_form_plainPassword_second', this)"
                            aria-label="Mostrar contraseña">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                {{ form_errors(registrationForm.plainPassword.second) }}
            </div>

            {# Honeypot for bots - see RegistrationFormType #}
            <div class="auth-hp" aria-hidden="true">
                {{ form_row(registrationForm.website) }}
            </div>

            {# Submit button #}
            <button type="submit" class="btn btn-auth btn-submit">
                <span class="btn-text"><i class="fas fa-user-plus"></i> Crear cuenta</span>
                <span class="btn-spinner"></span>
            </button>

            {{ form_end(registrationForm) }}
        </div>

        {# Footer link #}
        <div class="auth-footer">
            <a href="{{ path('login') }}" class="auth-link">
                <i class="fas fa-sign-in-alt"></i>
                <span>¿Ya tienes una cuenta? Inicia sesión</span>
            </a>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/auth_form.js?v=1.0') }}"></script>
{% endblock %}