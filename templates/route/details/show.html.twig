{% extends 'base.html.twig' %}

{% block title %}{{ route.name }} - Ruta de {{ route.routeType.value|capitalize }} {{ route.difficulty }} | ClimbUp{% endblock %}

{% block meta_description %}{{ route.name }}: ruta de {{ route.routeType.value }} con dificultad {{ route.difficulty }}, {{ route.pitches }} largo{{ route.pitches > 1 ? 's' : '' }} y {{ route.length }}m en {{ route.location.name }}. Consulta detalles y guarda la ruta.{% endblock %}

{% block canonical %}{{ url('app_route_show', {id: route.id}) }}{% endblock %}

{% block og_type %}article{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "{{ url('homepage') }}"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Rutas",
            "item": "{{ url('app_route_user_view') }}"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{ route.name }}"
        }
    ]
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "SportsActivityLocation",
    "name": "{{ route.name }}",
    "description": "Ruta de {{ route.routeType.value }} con dificultad {{ route.difficulty }}, {{ route.pitches }} largo{{ route.pitches > 1 ? 's' : '' }} y {{ route.length }}m",
    "url": "{{ url('app_route_show', {id: route.id}) }}",
    "sport": "Escalada {{ route.routeType.value }}",
    "location": {
        "@type": "Place",
        "name": "{{ route.location.name }}",
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": {{ route.location.latitude }},
            "longitude": {{ route.location.longitude }}
        }
    },
    "additionalProperty": [
        {
            "@type": "PropertyValue",
            "name": "Dificultad",
            "value": "{{ route.difficulty }}"
        },
        {
            "@type": "PropertyValue",
            "name": "Longitud",
            "value": "{{ route.length }}m"
        },
        {
            "@type": "PropertyValue",
            "name": "Largos",
            "value": "{{ route.pitches }}"
        }
    ]{% if route.rating %},
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ route.rating|number_format(1) }}",
        "bestRating": "4",
        "worstRating": "0",
        "ratingCount": "1"
    }{% endif %}
}
</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/route/details/show.css?v=2.1') }}">
{% endblock %}

{% block body %}
    <div class="route-detail-wrapper">
        <!-- Breadcrumbs -->
        <div class="container">
            <nav class="breadcrumbs">
                <a href="{{ path('homepage') }}" class="breadcrumb-item">
                    <i class="fas fa-home"></i>
                    <span>Inicio</span>
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <a href="{% if is_granted('ROLE_ADMIN') %}{{ path('app_route_index') }}{% else %}{{ path('app_route_user_view') }}{% endif %}" class="breadcrumb-item">
                    <i class="fas fa-route"></i>
                    <span>Rutas</span>
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <span class="breadcrumb-item active">{{ route.name }}</span>
            </nav>
        </div>

        <div class="container route-detail-container">
            <!-- Route Header Card -->
            <div class="route-header-card glass-card">
                <div class="route-header-content">
                    <div class="route-title-section">
                        <h1 class="route-title">{{ route.name }}</h1>
                        <div class="route-badges">
                            <span class="route-type-badge route-type-{{ route.routeType.value|lower }}">
                                <i class="fas fa-mountain"></i>
                                <span>{{ route.routeType.value }}</span>
                            </span>
                            <span class="difficulty-badge">
                                <i class="fas fa-signal"></i>
                                <span>{{ route.difficulty }}</span>
                            </span>
                        </div>
                    </div>

                    {% if app.user %}
                        <div class="route-actions-quick">
                            <button class="btn btn-icon-only btn-save" id="saveRouteBtn" data-route-id="{{ route.id }}" title="Guardar ruta">
                                <i class="fas fa-bookmark"></i>
                            </button>
                            <button class="btn btn-icon-only btn-share" id="shareRouteBtn" title="Compartir">
                                <i class="fas fa-share-alt"></i>
                            </button>
                        </div>
                    {% endif %}
                </div>

                <!-- Location Info Banner -->
                <div class="location-banner">
                    <i class="fas fa-map-marker-alt"></i>
                    <div class="location-info">
                        <div class="location-name">
                            {{ route.location.name }}
                            {% if route.location.region %}
                                <span class="location-region">{{ route.location.region }}</span>
                            {% endif %}
                        </div>
                        {% if route.sector %}
                            <div class="location-sector">{{ route.sector }}</div>
                        {% endif %}
                        <div class="location-coords">
                            {{ route.location.latitude|number_format(4) }}, {{ route.location.longitude|number_format(4) }}
                        </div>
                    </div>
                    <a href="{{ path('map') }}" class="btn btn-secondary btn-sm">
                        <i class="fas fa-map"></i>
                        <span>Ver en Mapa</span>
                    </a>
                </div>
            </div>

            <!-- Route Details Grid -->
            <div class="route-details-grid">
                <!-- Info Card -->
                <div class="info-card glass-card">
                    <h3 class="info-card-title">
                        <i class="fas fa-info-circle"></i>
                        <span>Información de la Ruta</span>
                    </h3>

                    <div class="info-items">
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-ruler-vertical"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Longitud</div>
                                <div class="info-value">{{ route.length }} metros</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-layer-group"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Número de Largos</div>
                                <div class="info-value">{{ route.pitches }}</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-signal"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Grado de Dificultad</div>
                                <div class="info-value">{{ route.difficulty }}</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fas fa-mountain"></i>
                            </div>
                            <div class="info-content">
                                <div class="info-label">Tipo de Escalada</div>
                                <div class="info-value">{{ route.routeType.value }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Card -->
                <div class="stats-card glass-card">
                    <h3 class="stats-card-title">
                        <i class="fas fa-chart-bar"></i>
                        <span>Estadísticas</span>
                    </h3>

                    <div class="stats-items">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-value">-</div>
                                <div class="stat-label">Ascensos</div>
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-bookmark"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-value">-</div>
                                <div class="stat-label">Guardadas</div>
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-star"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-value">{{ route.rating ? route.rating|number_format(1) ~ '/4' : '-' }}</div>
                                <div class="stat-label">Valoración</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons-section">
                <a href="{% if is_granted('ROLE_ADMIN') %}{{ path('app_route_index') }}{% else %}{{ path('app_route_user_view') }}{% endif %}" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left"></i>
                    <span>Volver al Listado</span>
                </a>


                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_route_edit', {'id': route.id}) }}" class="btn btn-primary btn-lg">
                        <i class="fas fa-edit"></i>
                        <span>Editar Ruta</span>
                    </a>
                {% endif %}
            </div>

            {% if similarRoutes|length > 0 %}
                <section class="similar-routes-section">
                    <h3 class="similar-routes-title">
                        <i class="fas fa-layer-group"></i>
                        <span>Rutas Similares</span>
                    </h3>
                    <div class="similar-routes-grid">
                        {% for similar in similarRoutes %}
                            <a href="{{ path('app_route_show', {'id': similar.id}) }}" class="similar-route-card glass-card">
                                <div class="similar-route-header">
                                    <span class="route-name">{{ similar.name }}</span>
                                    <span class="route-type-badge route-type-{{ similar.routeType.value|lower }}">{{ similar.routeType.value }}</span>
                                </div>
                                <div class="similar-route-meta">
                                    <span><i class="fas fa-signal"></i> {{ similar.difficulty }}</span>
                                    <span><i class="fas fa-map-marker-alt"></i> {{ similar.location.name }}</span>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-container">
        <div class="toast toast-success" id="successToast">
            <div class="toast-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="toast-content">
                <div class="toast-title">¡Éxito!</div>
                <div class="toast-message" id="toastMessage"></div>
            </div>
            <button class="toast-close" onclick="closeToast()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>

    <div id="route-data"
         data-route-id="{{ route.id }}"
         data-check-saved="{{ path('app_check_saved_route') }}"
         data-save-route="{{ path('app_save_route') }}">
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/routes/show.js?v=1.0') }}"></script>
{% endblock %}