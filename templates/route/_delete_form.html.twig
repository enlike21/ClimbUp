<form method="post" action="{{ path('app_route_delete', {'id': route.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ route.id) }}">
    <button type="button" class="btn btn-danger" data-confirm="¿Estás seguro de que deseas eliminar esta ruta? Esta acción no se puede deshacer.">Eliminar</button>
</form>
