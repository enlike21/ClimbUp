{% extends 'base.html.twig' %}

{% block title %}Crear Nueva Ruta - ClimbUp{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/route/management/new_edit_route.css?v=2.0') }}">
{% endblock %}

{% block body %}
    <div class="form-wrapper">
        <div class="container">
            <nav class="breadcrumbs">
                <a href="{{ path('homepage') }}" class="breadcrumb-item">
                    <i class="fas fa-home"></i>
                    <span>Inicio</span>
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <a href="{{ path('app_admin_dashboard') }}" class="breadcrumb-item">
                    <i class="fas fa-shield-alt"></i>
                    <span>Admin</span>
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <a href="{{ path('app_route_index') }}" class="breadcrumb-item">
                    <i class="fas fa-mountain"></i>
                    <span>Rutas</span>
                </a>
                <i class="fas fa-chevron-right breadcrumb-separator"></i>
                <span class="breadcrumb-item active">Nueva Ruta</span>
            </nav>

            <div class="form-hero">
                <div class="hero-icon">
                    <i class="fas fa-plus-circle"></i>
                </div>
                <h1 class="hero-title">Crear Nueva Ruta</h1>
                <p class="hero-subtitle">Completa la información para registrar una nueva ruta de escalada</p>
            </div>

            <div class="form-card glass-card">
                {{ form_start(form, {'attr': {'class': 'route-form'}}) }}

                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.name, 'Nombre de la Ruta <span class="required-indicator">*</span>', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            <i class="fas fa-map-signs input-icon"></i>
                            {{ form_widget(form.name, {'attr': {'class': 'form-input', 'placeholder': 'Ej: La Gran Pared'}}) }}
                        </div>
                        <div class="form-error">{{ form_errors(form.name) }}</div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.routeType, 'Tipo de Ruta <span class="required-indicator">*</span>', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            <i class="fas fa-mountain input-icon"></i>
                            {{ form_widget(form.routeType, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="form-error">{{ form_errors(form.routeType) }}</div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.difficulty, 'Dificultad <span class="required-indicator">*</span>', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            <i class="fas fa-signal input-icon"></i>
                            {{ form_widget(form.difficulty, {'attr': {'class': 'form-input', 'placeholder': 'Ej: 6a+'}}) }}
                        </div>
                        <div class="form-error">{{ form_errors(form.difficulty) }}</div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.length, 'Longitud (metros) <span class="required-indicator">*</span>', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            <i class="fas fa-ruler-vertical input-icon"></i>
                            {{ form_widget(form.length, {'attr': {'class': 'form-input', 'placeholder': 'Ej: 35'}}) }}
                        </div>
                        <div class="form-error">{{ form_errors(form.length) }}</div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.pitches, 'Número de Largos <span class="required-indicator">*</span>', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            <i class="fas fa-layer-group input-icon"></i>
                            {{ form_widget(form.pitches, {'attr': {'class': 'form-input', 'placeholder': 'Ej: 2'}}) }}
                        </div>
                        <div class="form-error">{{ form_errors(form.pitches) }}</div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.location, 'Ubicación <span class="required-indicator">*</span>', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-wrapper">
                            <i class="fas fa-map-marker-alt input-icon"></i>
                            {{ form_widget(form.location, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="form-error">{{ form_errors(form.location) }}</div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="{{ path('app_route_index') }}" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i>
                        <span>Cancelar</span>
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg btn-submit">
                        <span class="btn-text"><i class="fas fa-save"></i> Guardar Ruta</span>
                        <span class="btn-spinner"></span>
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}