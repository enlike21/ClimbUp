{% extends 'base.html.twig' %}

{% block title %}Asistente de Escalada - ClimbUp{% endblock %}
{% block meta_description %}Pregunta al asistente de ClimbUp y encuentra rutas de escalada ideales para ti.{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/components/chatbot-widget.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/pages/chatbot.css') }}">
{% endblock %}

{% block body %}
<section class="chatbot-page">
    <div class="container">
        <div class="chatbot-page-header">
            <div class="chatbot-page-icon">
                <i class="fas fa-mountain"></i>
            </div>
            <h1>Asistente de <span class="text-gradient">Escalada</span></h1>
            <p>Preguntame en lenguaje natural y te ayudo a encontrar la ruta perfecta</p>
        </div>

        <div class="chatbot-page-container">
            <div class="chatbot-page-toolbar">
                <div class="chatbot-page-toolbar-info">
                    <span class="chatbot-status-dot"></span>
                    <span>ClimbUp AI</span>
                </div>
                <button class="chatbot-page-clear-btn" id="chatbotClearBtn" title="Nueva conversación">
                    <i class="fas fa-redo-alt"></i>
                    <span>Nueva conversación</span>
                </button>
            </div>

            <div class="chatbot-messages" id="chatbotPageMessages">
                <div class="chatbot-message chatbot-message-bot">
                    <div class="chatbot-msg-avatar"><i class="fas fa-robot"></i></div>
                    <div class="chatbot-msg-content">
                        <p>¡Hola! Soy el asistente de ClimbUp. Puedo ayudarte a encontrar rutas de escalada. Prueba a preguntarme:</p>
                        <div class="chatbot-suggestions">
                            <button class="chatbot-suggestion" data-message="Quiero una ruta fácil de deportiva"><i class="fas fa-child"></i> Deportiva fácil</button>
                            <button class="chatbot-suggestion" data-message="Rutas de deportiva difícil"><i class="fas fa-fire"></i> Deportiva difícil</button>
                            <button class="chatbot-suggestion" data-message="Las mejores rutas valoradas"><i class="fas fa-star"></i> Mejor valoradas</button>
                            <button class="chatbot-suggestion" data-message="Rutas de escalada tradicional"><i class="fas fa-mountain"></i> Trad</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="chatbot-typing" id="chatbotPageTyping">
                <div class="chatbot-msg-avatar"><i class="fas fa-robot"></i></div>
                <div class="chatbot-typing-dots"><span></span><span></span><span></span></div>
            </div>

            <form class="chatbot-input-area" id="chatbotPageForm">
                <input type="text" id="chatbotPageInput" class="chatbot-input" placeholder="Ej: Quiero una ruta fácil de deportiva en Andalucía..." autocomplete="off" maxlength="500">
                <button type="submit" class="chatbot-send-btn"><i class="fas fa-paper-plane"></i></button>
            </form>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/chatbot.js') }}"></script>
{% endblock %}
