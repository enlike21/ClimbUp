#!/usr/bin/env bash
# Repository rule: no source file may be longer than MAX_LINES lines.
# Run by CI (.github/workflows/ci.yml) on every push and pull request; run it locally with
#   bin/check-file-length
# Long files are hard to review and make PRs collide: split them by responsibility instead.

set -euo pipefail

MAX_LINES=1000

# Generated or third-party files: never edited by hand, so the rule doesn't apply.
is_excluded() {
    case "$1" in
        composer.lock|package-lock.json|symfony.lock) return 0 ;;
        config/reference.php) return 0 ;;          # generated by Symfony
        LICENSE) return 0 ;;
        assets/vendor/*) return 0 ;;               # vendored by importmap
        tests/fixtures/*|data/*) return 0 ;;       # test fixtures and sample data
        *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.svg|*.woff|*.woff2) return 0 ;;
    esac
    return 1
}

# Temporary exceptions: files that were already too long when the rule was added. Each one
# has an issue to split it and a cap so it can't keep growing. Remove the line once split.
exception_cap() {
    case "$1" in
        public/js/game/render.js) echo 1700 ;;                        # issue #15
        public/js/game/main.js) echo 1350 ;;                          # issue #16
        public/styles/main.css) echo 1100 ;;                          # issue #18
        public/styles/pages/saved_routes/saved_routes.css) echo 1150 ;; # issue #18
        *) echo "" ;;
    esac
}

failed=0
while IFS= read -r file; do
    [ -f "$file" ] || continue
    is_excluded "$file" && continue
    lines=$(wc -l < "$file" | tr -d ' ')
    cap=$(exception_cap "$file")
    limit=${cap:-$MAX_LINES}
    if [ "$lines" -gt "$limit" ]; then
        if [ -n "$cap" ]; then
            echo "✗ $file: $lines lines (temporary cap $cap until it is split - see bin/check-file-length)"
        else
            echo "✗ $file: $lines lines (max $MAX_LINES) - split it into smaller files"
        fi
        failed=1
    fi
done < <(git ls-files)

if [ "$failed" -ne 0 ]; then
    echo
    echo "Some files are too long. See the \"Tamaño de los archivos\" section in CONTRIBUTING.md."
    exit 1
fi

echo "✓ No file is longer than $MAX_LINES lines (apart from the listed temporary exceptions)."
